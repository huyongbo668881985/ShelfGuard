/* app.wxss - 全局样式（特8水印 / ShelfGuard 皮肤 v2） */

/* CSS 变量 - 统一设计系统 */
page {
  /* 主品牌色：沉稳蓝墨 + 暖金点缀（呼应白酒行业质感） */
  --color-primary: #1C3D5A;
  --color-primary-light: #2E5A82;
  --color-primary-dark: #122A40;
  --color-accent: #C2933B;

  --color-success: #2E9E5B;
  --color-warning: #E08A1E;
  --color-error: #D6453D;
  --color-info: #2D7FD6;

  --color-text-primary: #1F2933;
  --color-text-secondary: #5A6470;
  --color-text-hint: #9AA0A6;
  --color-text-disabled: #C7CBD1;

  --color-bg-page: #F4F6F9;
  --color-bg-card: #FFFFFF;
  --color-bg-hover: #EEF2F7;
  --color-border: #E4E8EE;
  --color-divider: #EEF1F5;

  --radius-sm: 10rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 28rpx;
  --radius-round: 999rpx;

  --shadow-sm: 0 2rpx 10rpx rgba(28, 61, 90, 0.05);
  --shadow-md: 0 6rpx 20rpx rgba(28, 61, 90, 0.08);
  --shadow-lg: 0 12rpx 36rpx rgba(28, 61, 90, 0.12);

  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 44rpx;

  background-color: var(--color-bg-page);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: var(--font-md);
  color: var(--color-text-primary);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* 全局兜底：强制所有 input/textarea 文字深色、白底，避免真机上颜色继承异常导致看不见
   （原生输入组件部分机型/基础库不继承 page 文字色，必须显式声明） */
input,
textarea {
  color: #1F2933 !important;
  background-color: #fff !important;
}

/* 通用容器 */
.container {
  padding: var(--spacing-lg);
}

/* 卡片 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-divider);
}

/* 按钮系统 */
.btn-primary {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: #fff;
  border: none;
  border-radius: var(--radius-lg);
  padding: 24rpx 0;
  font-size: var(--font-lg);
  font-weight: 500;
  text-align: center;
  width: 100%;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 16rpx rgba(28, 61, 90, 0.18);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-secondary {
  background: var(--color-bg-card);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-lg);
  padding: 24rpx 0;
  font-size: var(--font-lg);
  text-align: center;
  width: 100%;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background: var(--color-bg-hover);
}

/* 金色强调按钮（关键动作 / 高亮 CTA） */
.btn-accent {
  background: linear-gradient(135deg, var(--color-accent) 0%, #D9A94E 100%);
  color: #fff;
  border: none;
  border-radius: var(--radius-lg);
  padding: 24rpx 0;
  font-size: var(--font-lg);
  font-weight: 500;
  text-align: center;
  width: 100%;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 16rpx rgba(194, 147, 59, 0.22);
}

.btn-accent::after {
  border: none;
}

.btn-accent:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-ghost {
  background: transparent;
  color: var(--color-text-secondary);
  border: none;
  padding: 16rpx 24rpx;
  font-size: var(--font-md);
}

/* 文字样式 */
.text-primary { color: var(--color-text-primary); }
.text-secondary { color: var(--color-text-secondary); }
.text-hint { color: var(--color-text-hint); }
.text-success { color: var(--color-success); }
.text-warning { color: var(--color-warning); }
.text-error { color: var(--color-error); }
.text-accent { color: var(--color-accent); }

.text-bold { font-weight: 600; }
.text-center { text-align: center; }

/* 文字省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* Flex 工具类 */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-row { display: flex; flex-direction: row; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }
.items-center { align-items: center; }
.justify-center { justify-content: center; }
.gap-sm { gap: var(--spacing-sm); }
.gap-md { gap: var(--spacing-md); }

/* 间距工具类 */
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.p-sm { padding: var(--spacing-sm); }
.p-md { padding: var(--spacing-md); }
.p-lg { padding: var(--spacing-lg); }

/* 加载状态 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(18, 42, 64, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-mask .loading-text {
  color: #fff;
  font-size: var(--font-lg);
  margin-top: var(--spacing-md);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--color-divider);
  margin: var(--spacing-md) 0;
}

/* 安全区域底部 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 页面背景渐变（顶部品牌色过渡到底部浅灰） */
.page-gradient {
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-bg-page) 45%);
}

/* 品牌头部（列表/设置类页面可放在顶部，统一品牌感） */
.brand-header {
  padding: var(--spacing-lg);
  padding-top: calc(var(--spacing-lg) + 8rpx);
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: #fff;
}

.brand-header .brand-logo {
  font-size: var(--font-xl);
  font-weight: 700;
  letter-spacing: 3rpx;
}

.brand-header .brand-sub {
  font-size: var(--font-sm);
  opacity: 0.82;
  margin-top: 6rpx;
}

.brand-header .brand-logo-img {
  width: 108rpx;
  height: 108rpx;
  margin-bottom: 14rpx;
}

/* 全宽品牌头：用于自身带页面内边距的页面，用负边距抵消实现通栏 */
.brand-header--full {
  margin: calc(-1 * var(--spacing-md)) calc(-1 * var(--spacing-lg)) var(--spacing-md);
}

/* 徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-round);
  font-size: var(--font-xs);
  font-weight: 500;
}

.badge-success {
  background: #E7F6ED;
  color: var(--color-success);
}

.badge-warning {
  background: #FCEFD9;
  color: var(--color-warning);
}

.badge-error {
  background: #FBE9E8;
  color: var(--color-error);
}

.badge-info {
  background: #E6F1FB;
  color: var(--color-info);
}
