.inspection-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.card-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-uploaded {
  background: #fff3e0;
  color: #f57c00;
}

.status-analyzed {
  background: #e8f5e9;
  color: #388e3c;
}

.card-body {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.card-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.card-date {
  font-size: 26rpx;
  color: #999;
}

.card-store {
  font-size: 26rpx;
  color: #666;
  max-width: 400rpx;
}

.card-address {
  font-size: 24rpx;
  color: #999;
  max-width: 400rpx;
}

.card-user {
  font-size: 24rpx;
  color: #999;
}

.card-score {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.score-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.score-unit {
  font-size: 24rpx;
  color: #999;
}
