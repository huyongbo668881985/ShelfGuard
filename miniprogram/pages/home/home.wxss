/* pages/home/home.wxss */
.home-page {
  min-height: 100vh;
  background: #F4F6F9;
  padding-bottom: 40rpx;
}

.approval-banner {
  background: #FFF4E0;
  color: #B26A00;
  font-size: 26rpx;
  padding: 16rpx 30rpx;
  text-align: center;
}

.hero {
  background: linear-gradient(160deg, #1C3D5A 0%, #2E5A82 100%);
  color: #fff;
  padding: 40rpx 40rpx 60rpx;
  border-radius: 0 0 36rpx 36rpx;
}

.hero-hello {
  font-size: 40rpx;
  font-weight: 600;
}

.hero-date {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.75;
}

.start-btn {
  margin-top: 40rpx;
  height: 120rpx;
  line-height: 120rpx;
  background: #C2933B;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  border-radius: 60rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.start-btn::after {
  border: none;
}

.start-btn[disabled] {
  opacity: 0.7;
  color: #fff;
}

.start-icon {
  margin-right: 14rpx;
}

.hero-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  opacity: 0.7;
}

.offline-banner {
  margin: 24rpx 30rpx 0;
  padding: 20rpx 24rpx;
  background: #FFF4E0;
  color: #B26A00;
  border-radius: 16rpx;
  font-size: 26rpx;
  display: flex;
  justify-content: space-between;
}

.record-card {
  margin: 24rpx 30rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2933;
}

.record-more {
  font-size: 26rpx;
  color: #2E5A82;
  padding: 8rpx 0 8rpx 20rpx;
}

.date-bar {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.date-arrow {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 40rpx;
  color: #1C3D5A;
  background: #EEF2F7;
  border-radius: 12rpx;
}

.date-arrow.disabled {
  color: #C7CBD1;
}

.date-current {
  margin: 0 16rpx;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  color: #1F2933;
  background: #EEF2F7;
  border-radius: 12rpx;
}

.date-today {
  margin-left: auto;
  font-size: 26rpx;
  color: #C2933B;
}

.summary-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #EEF1F5;
  border-bottom: 1rpx solid #EEF1F5;
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #1C3D5A;
}

.summary-label {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #9AA0A6;
}

.summary-divider {
  width: 1rpx;
  height: 56rpx;
  background: #EEF1F5;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #EEF1F5;
}

.record-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #EEF2F7;
}

.record-thumb.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.record-body {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.record-store {
  font-size: 30rpx;
  color: #1F2933;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9AA0A6;
}

.record-right {
  flex-shrink: 0;
}

.record-score {
  font-size: 40rpx;
  font-weight: 600;
}

.record-status {
  font-size: 24rpx;
  color: #9AA0A6;
}

.empty {
  padding: 60rpx 0 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #9AA0A6;
}

.loading-tip {
  padding: 24rpx 0 0;
  text-align: center;
  font-size: 24rpx;
  color: #9AA0A6;
}
