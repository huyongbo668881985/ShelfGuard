/* pages/history/history.wxss */

.history-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  margin: 24rpx 30rpx;
  border-radius: 16rpx;
  padding: 36rpx 20rpx;
  color: #fff;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats-value {
  font-size: 48rpx;
  font-weight: bold;
  line-height: 1;
}

.stats-label {
  font-size: 24rpx;
  opacity: 0.8;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 30rpx 20rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.filter-badge {
  color: #f44336;
  font-size: 32rpx;
}

/* 筛选标签 */
.filter-tags {
  display: flex;
  gap: 12rpx;
  padding: 0 30rpx 16rpx;
  flex-wrap: wrap;
}

.filter-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #e3f2fd;
  color: #1976d2;
  border-radius: 20rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
}

.tag-close {
  font-size: 20rpx;
  opacity: 0.7;
}

/* 列表容器 */
.list-container {
  padding: 0 30rpx;
}

/* 列表项 */
.history-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 缩略图 */
.item-thumbnail {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 24rpx;
  background: #f5f5f5;
}

.thumbnail-img {
  width: 100%;
  height: 100%;
}

.thumbnail-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #ccc;
}

/* 内容区 */
.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-score {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

/* 列表项状态标记：待分析 / 分析中 / 分析失败 */
.item-status {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 1;
  padding: 8rpx 14rpx;
  border-radius: 20rpx;
  background: #e8f0fe;
  color: #1a73e8;
}

.item-status.status-analyzing {
  background: #fff3e0;
  color: #e65100;
}

.item-status.status-analyze_failed {
  background: #fdecea;
  color: #d32f2f;
}

.item-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin: 12rpx 0;
}

.item-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.item-date {
  color: #999;
}

.item-user {
  color: #666;
}

.item-photos {
  color: #1976d2;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

/* 加载更多 */
.loading-more,
.no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}

/* 筛选面板 */
.filter-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.filter-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 60vh;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding-bottom: 60rpx;
}

.filter-panel.show {
  transform: translateY(0);
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #eee;
}

.filter-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.filter-clear {
  font-size: 28rpx;
  color: #1976d2;
}

.filter-section {
  padding: 30rpx 40rpx;
}

.filter-section-title {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.filter-options {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.filter-option {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #333;
}

.filter-option.active {
  background: var(--color-primary);
  color: #fff;
}

.filter-username-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.filter-username-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.filter-username-apply {
  flex-shrink: 0;
  padding: 16rpx 28rpx;
  background: var(--color-primary);
  color: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
}

/* 今日汇总结论卡片 */
.daily-summary-card {
  margin: 0 30rpx 24rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f6f8fb 100%);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(28, 61, 90, 0.08);
  border: 2rpx solid rgba(194, 147, 59, 0.25);
}

.daily-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.daily-title-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.daily-icon {
  font-size: 38rpx;
}

.daily-main-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1C3D5A;
  display: block;
}

.daily-date-sub {
  font-size: 22rpx;
  color: #888;
}

.daily-score-badge {
  text-align: center;
  padding: 6rpx 18rpx;
  border-radius: 14rpx;
  min-width: 80rpx;
}

.daily-score-badge.score-high {
  background: #e8f5e9;
  color: #2e7d32;
}

.daily-score-badge.score-mid {
  background: #fff3e0;
  color: #e65100;
}

.daily-score-badge.score-low {
  background: #ffebee;
  color: #c62828;
}

.daily-score-number {
  font-size: 34rpx;
  font-weight: bold;
  line-height: 1;
  display: block;
}

.daily-score-text {
  font-size: 20rpx;
}

.daily-conclusion-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.daily-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14rpx;
  border-top: 1rpx dashed #e8ebf0;
}

.daily-issues-preview {
  font-size: 22rpx;
  color: #d9534f;
  max-width: 70%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.daily-view-link {
  font-size: 24rpx;
  color: var(--color-accent, #C2933B);
  font-weight: 500;
}

/* 完整日报模态弹窗 */
.daily-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
}

.daily-modal-panel {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 82vh;
  z-index: 1001;
  display: flex;
  flex-direction: column;
}

.daily-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx 20rpx;
  border-bottom: 1rpx solid #eee;
}

.daily-modal-title .title-main {
  font-size: 32rpx;
  font-weight: bold;
  color: #1C3D5A;
  display: block;
}

.daily-modal-title .title-sub {
  font-size: 24rpx;
  color: #999;
}

.daily-modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
}

.daily-modal-scroll {
  flex: 1;
  padding: 24rpx 36rpx;
  box-sizing: border-box;
}

.daily-score-block {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: #f8fafc;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.score-circle {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.score-circle.score-high {
  background: #2e7d32;
  color: #fff;
}

.score-circle.score-mid {
  background: #ff9800;
  color: #fff;
}

.score-big {
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1;
}

.score-lvl {
  font-size: 20rpx;
}

.conclusion-desc {
  flex: 1;
}

.desc-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #1C3D5A;
  display: block;
  margin-bottom: 8rpx;
}

.desc-body {
  font-size: 26rpx;
  color: #444;
  line-height: 1.6;
}

.daily-section-card {
  background: #fff;
  border: 1rpx solid #eef1f5;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-badge {
  font-size: 28rpx;
  font-weight: bold;
  color: #1C3D5A;
  display: block;
  margin-bottom: 16rpx;
}

.overview-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.overview-item {
  flex: 1;
  background: #f8fafc;
  padding: 16rpx;
  border-radius: 12rpx;
  text-align: center;
}

.ov-label {
  font-size: 22rpx;
  color: #888;
  display: block;
}

.ov-val {
  font-size: 32rpx;
  font-weight: bold;
  color: #1C3D5A;
}

.ov-sit {
  font-size: 24rpx;
  color: #555;
  line-height: 1.5;
  display: block;
}

.daily-issue-item {
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #f0f0f0;
}
.daily-issue-item:last-child {
  border-bottom: none;
}

.issue-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.issue-cat {
  font-size: 26rpx;
  font-weight: bold;
  color: #d9534f;
}

.issue-aff {
  font-size: 22rpx;
  color: #888;
}

.issue-desc {
  font-size: 24rpx;
  color: #444;
  line-height: 1.5;
}

.daily-action-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
}

.action-prio {
  font-size: 20rpx;
  font-weight: bold;
  background: #1C3D5A;
  color: #fff;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.action-text-group {
  flex: 1;
}

.action-main {
  font-size: 26rpx;
  color: #222;
  font-weight: 500;
  display: block;
}

.action-target {
  font-size: 22rpx;
  color: #888;
}

.ranking-item {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f8f8f8;
  font-size: 26rpx;
}

.ranking-item:last-child {
  border-bottom: none;
}

.rk-store {
  color: #333;
}

.rk-score {
  color: #1C3D5A;
  font-weight: 500;
}

.daily-modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 36rpx 40rpx;
  border-top: 1rpx solid #eee;
}

.daily-modal-footer .modal-btn {
  flex: 1;
  font-size: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  margin: 0;
}


/* 排面看板入口 */
.dash-entry-row {
  display: flex;
  gap: 16rpx;
  padding: 0 30rpx 20rpx;
}

.dash-entry-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.dash-entry-icon {
  font-size: 28rpx;
}

.dash-entry-text {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
}
