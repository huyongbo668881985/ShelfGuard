<!--pages/history/history.wxml-->
<view class="history-page">
  <!-- 品牌头 -->
  <view class="brand-header">
    <image class="brand-logo-img" src="/images/logo.png" mode="aspectFit"></image>
    <view class="brand-logo">特8水印</view>
    <view class="brand-sub">白酒终端巡检 · 智能水印</view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stats-item">
      <text class="stats-value">{{stats.total}}</text>
      <text class="stats-label">总巡检</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <text class="stats-value">{{stats.avgScore}}</text>
      <text class="stats-label">平均分</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <text class="stats-value">{{stats.thisWeek}}</text>
      <text class="stats-label">本周</text>
    </view>
  </view>

  <!-- 今日巡检汇总结论卡片（晚间集中分析生成的大盘结论） -->
  <view class="daily-summary-card" wx:if="{{latestDailyReport && latestDailyReport.report}}" bindtap="viewDailyReportDetail">
    <view class="daily-card-top">
      <view class="daily-title-group">
        <text class="daily-icon">📊</text>
        <view>
          <text class="daily-main-title">{{latestDailyReport.report.summaryTitle || '今日终端巡检综合分析日报'}}</text>
          <text class="daily-date-sub">{{latestDailyReport.date}} · 汇总 {{latestDailyReport.inspectionCount}} 家门店</text>
        </view>
      </view>
      <view class="daily-score-badge score-{{latestDailyReport.report.overallScore >= 80 ? 'high' : latestDailyReport.report.overallScore >= 60 ? 'mid' : 'low'}}">
        <text class="daily-score-number">{{latestDailyReport.report.overallScore}}</text>
        <text class="daily-score-text">{{latestDailyReport.report.overallLevel || '良好'}}</text>
      </view>
    </view>

    <view class="daily-conclusion-text">
      {{latestDailyReport.report.summaryConclusion}}
    </view>

    <view class="daily-card-footer">
      <text class="daily-issues-preview" wx:if="{{latestDailyReport.report.commonIssues && latestDailyReport.report.commonIssues.length > 0}}">
        ⚠️ 共性问题：{{latestDailyReport.report.commonIssues[0].category}} - {{latestDailyReport.report.commonIssues[0].description}}
      </text>
      <text class="daily-view-link">查看完整日报 ›</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrapper">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索门店或任务"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
      <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="onClearSearch">✕</text>
    </view>
    <view class="filter-btn" bindtap="onShowFilter">
      <text>筛选</text>
      <text class="filter-badge" wx:if="{{filterDate || filterScore || filterUserName}}">•</text>
    </view>
  </view>

  <!-- 当前筛选标签 -->
  <view class="filter-tags" wx:if="{{filterDate || filterScore || filterUserName}}">
    <view class="filter-tag" wx:if="{{filterUserName}}">
      <text>业务员：{{filterUserName}}</text>
      <text class="tag-close" bindtap="onClearUserNameFilter">✕</text>
    </view>
    <view class="filter-tag" wx:if="{{filterDate}}">
      <text>{{filterDate === 'today' ? '今天' : filterDate === 'week' ? '近7天' : '近30天'}}</text>
      <text class="tag-close" bindtap="onSelectDateFilter" data-value="{{filterDate}}">✕</text>
    </view>
    <view class="filter-tag" wx:if="{{filterScore}}">
      <text>{{filterScore === 'high' ? '80分以上' : filterScore === 'medium' ? '60-79分' : '60分以下'}}</text>
      <text class="tag-close" bindtap="onSelectScoreFilter" data-value="{{filterScore}}">✕</text>
    </view>
  </view>

  <!-- 列表 -->
  <view class="list-container" wx:if="{{list.length > 0}}">
    <view
      class="history-item"
      wx:for="{{list}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onTapItem"
    >
      <!-- 缩略图 -->
      <view class="item-thumbnail">
        <image
          class="thumbnail-img"
          src="{{item.thumbnailURL || item.thumbnailFileID}}"
          mode="aspectFill"
          wx:if="{{item.thumbnailURL || item.thumbnailFileID}}"
        ></image>
        <view class="thumbnail-placeholder" wx:else>
          <text>📷</text>
        </view>
      </view>

      <!-- 内容区 -->
      <view class="item-content">
      <view class="item-header">
        <text class="item-title">{{item.storeName || item.taskName || '未命名'}}</text>
        <view class="item-status status-{{item.status}}" wx:if="{{item.statusText}}">{{item.statusText}}</view>
        <view class="item-score" wx:if="{{item.aiReport && item.aiReport.score}}" style="background: {{item.scoreColor}}">
          <text>{{item.aiReport.score}}</text>
        </view>
      </view>
        
        <text class="item-summary text-ellipsis" wx:if="{{item.aiReport && item.aiReport.summary}}">
          {{item.aiReport.summary}}
        </text>
        
        <view class="item-footer">
          <text class="item-date">{{item.displayDate}}</text>
          <text class="item-user" wx:if="{{item.userName}}">{{item.userName}}</text>
          <text class="item-photos" wx:if="{{item.photoCount > 1}}">{{item.photoCount}}张</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && list.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无巡检记录</text>
    <text class="empty-hint" wx:if="{{searchKeyword || filterDate || filterScore}}">
      尝试调整筛选条件
    </text>
    <text class="empty-hint" wx:else>去拍照开始第一次巡检吧</text>
  </view>

  <!-- 加载更多 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && list.length > 0}}">
    <text>— 没有更多了 —</text>
  </view>

  <!-- 筛选面板 -->
  <view class="filter-mask" wx:if="{{showFilter}}" bindtap="onCloseFilter"></view>
  <view class="filter-panel {{showFilter ? 'show' : ''}}">
    <view class="filter-header">
      <text class="filter-title">筛选条件</text>
      <text class="filter-clear" bindtap="onClearFilter">清除</text>
    </view>

    <view class="filter-section">
      <text class="filter-section-title">时间范围</text>
      <view class="filter-options">
        <view
          class="filter-option {{filterDate === 'today' ? 'active' : ''}}"
          data-value="today"
          bindtap="onSelectDateFilter"
        >今天</view>
        <view
          class="filter-option {{filterDate === 'week' ? 'active' : ''}}"
          data-value="week"
          bindtap="onSelectDateFilter"
        >近7天</view>
        <view
          class="filter-option {{filterDate === 'month' ? 'active' : ''}}"
          data-value="month"
          bindtap="onSelectDateFilter"
        >近30天</view>
      </view>
    </view>

    <view class="filter-section">
      <text class="filter-section-title">评分范围</text>
      <view class="filter-options">
        <view
          class="filter-option {{filterScore === 'high' ? 'active' : ''}}"
          data-value="high"
          bindtap="onSelectScoreFilter"
        >80分以上</view>
        <view
          class="filter-option {{filterScore === 'medium' ? 'active' : ''}}"
          data-value="medium"
          bindtap="onSelectScoreFilter"
        >60-79分</view>
        <view
          class="filter-option {{filterScore === 'low' ? 'active' : ''}}"
          data-value="low"
          bindtap="onSelectScoreFilter"
        >60分以下</view>
      </view>
    </view>
    <view class="filter-section" wx:if="{{isManager}}">
      <text class="filter-section-title">业务员（管理者视角，留空看全部）</text>
      <view class="filter-username-row">
        <input
          class="filter-username-input"
          placeholder="输入业务员姓名"
          value="{{filterUserName}}"
          bindinput="onFilterUserNameInput"
          bindconfirm="onApplyUserNameFilter"
        />
        <text class="filter-username-apply" bindtap="onApplyUserNameFilter">确定</text>
      </view>
    </view>
  </view>

  <!-- 今日巡检汇总结论完整弹窗 -->
  <view class="daily-modal-mask" wx:if="{{showDailyModal}}" bindtap="closeDailyModal"></view>
  <view class="daily-modal-panel {{showDailyModal ? 'show' : ''}}" wx:if="{{showDailyModal}}">
    <view class="daily-modal-header">
      <view class="daily-modal-title">
        <text class="title-main">{{latestDailyReport.report.summaryTitle || '今日巡检综合分析日报'}}</text>
        <text class="title-sub">{{latestDailyReport.date}} · 共评估 {{latestDailyReport.inspectionCount}} 家门店</text>
      </view>
      <text class="daily-modal-close" bindtap="closeDailyModal">✕</text>
    </view>

    <scroll-view class="daily-modal-scroll" scroll-y="true">
      <!-- 总评卡片 -->
      <view class="daily-score-block">
        <view class="score-circle score-{{latestDailyReport.report.overallScore >= 80 ? 'high' : 'mid'}}">
          <text class="score-big">{{latestDailyReport.report.overallScore}}</text>
          <text class="score-lvl">{{latestDailyReport.report.overallLevel || '良好'}}</text>
        </view>
        <view class="conclusion-desc">
          <text class="desc-title">💡 综合诊断结论</text>
          <text class="desc-body">{{latestDailyReport.report.summaryConclusion}}</text>
        </view>
      </view>

      <!-- 我方品牌表现 -->
      <view class="daily-section-card" wx:if="{{latestDailyReport.report.ownBrandOverview}}">
        <text class="section-badge">🏷️ 我方品牌终端大盘</text>
        <view class="overview-grid">
          <view class="overview-item">
            <text class="ov-label">排面占比</text>
            <text class="ov-val">{{latestDailyReport.report.ownBrandOverview.facingSharePercent}}%</text>
          </view>
          <view class="overview-item">
            <text class="ov-label">黄金位占比</text>
            <text class="ov-val">{{latestDailyReport.report.ownBrandOverview.goldenPositionRatio || '--'}}</text>
          </view>
        </view>
        <text class="ov-sit">{{latestDailyReport.report.ownBrandOverview.competitiveSituation}}</text>
      </view>

      <!-- 今日共性问题 Top3 -->
      <view class="daily-section-card" wx:if="{{latestDailyReport.report.commonIssues && latestDailyReport.report.commonIssues.length > 0}}">
        <text class="section-badge">⚠️ 今日共性问题</text>
        <view class="issue-list">
          <view class="daily-issue-item" wx:for="{{latestDailyReport.report.commonIssues}}" wx:key="index">
            <view class="issue-top">
              <text class="issue-cat">{{item.category}}</text>
              <text class="issue-aff">{{item.affectStores}}</text>
            </view>
            <text class="issue-desc">{{item.description}}</text>
          </view>
        </view>
      </view>

      <!-- 明日整改行动指南 -->
      <view class="daily-section-card" wx:if="{{latestDailyReport.report.actionPlanTomorrow && latestDailyReport.report.actionPlanTomorrow.length > 0}}">
        <text class="section-badge">🎯 明日行动指南</text>
        <view class="action-list">
          <view class="daily-action-item" wx:for="{{latestDailyReport.report.actionPlanTomorrow}}" wx:key="index">
            <text class="action-prio">{{item.priority || 'P' + (index + 1)}}</text>
            <view class="action-text-group">
              <text class="action-main">{{item.action}}</text>
              <text class="action-target" wx:if="{{item.target}}">目标：{{item.target}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 门店红黑榜简表 -->
      <view class="daily-section-card" wx:if="{{latestDailyReport.report.storeRankings && latestDailyReport.report.storeRankings.length > 0}}">
        <text class="section-badge">🏬 巡检门店表现简表</text>
        <view class="ranking-list">
          <view class="ranking-item" wx:for="{{latestDailyReport.report.storeRankings}}" wx:key="index">
            <text class="rk-store">{{item.storeName}}</text>
            <text class="rk-score">{{item.score}}分 · {{item.status}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作栏：一键复制发微信群 / 关闭 -->
    <view class="daily-modal-footer">
      <button class="btn-secondary modal-btn" bindtap="closeDailyModal">关闭</button>
      <button class="btn-primary modal-btn" bindtap="copyDailySummary">📋 复制日报发微信群</button>
    </view>
  </view>
</view>
