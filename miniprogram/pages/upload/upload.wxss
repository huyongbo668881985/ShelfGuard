/* pages/upload/upload.wxss */

.upload-page {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  padding-bottom: 200rpx;
}

/* 顶部信息栏 */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a2e;
}

.header-count {
  font-size: 26rpx;
  color: #999;
}

/* 照片滚动区域 */
.photo-scroll {
  background: #fff;
  padding: 24rpx 0;
  white-space: nowrap;
}

.photo-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 30rpx;
}

.photo-item {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(56, 142, 60, 0.9);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.badge-uploading {
  background: rgba(25, 118, 210, 0.9);
}

.badge-error {
  background: rgba(211, 47, 47, 0.9);
}

.photo-size {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  padding: 6rpx 12rpx;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}

/* 信息卡片 */
.info-card {
  margin: 24rpx 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #999;
  font-size: 28rpx;
}

.info-value {
  color: #333;
  font-size: 28rpx;
  max-width: 60%;
  text-align: right;
}

/* 进度区域 */
.progress-section {
  margin: 0 30rpx;
}

.progress-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-label {
  font-size: 28rpx;
  color: #333;
}

.progress-value {
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: bold;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1a1a2e 0%, #16213e 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-indeterminate {
  width: 30% !important;
  animation: indeterminate 1.5s infinite ease-in-out;
}

@keyframes indeterminate {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(400%); }
}

/* 成功状态 */
.success-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx;
}

.success-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #4caf50;
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.success-text {
  font-size: 30rpx;
  color: #333;
}

/* 已提交状态（集中分析模式） */
.submitted-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx 20rpx;
}

.submitted-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #4caf50;
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.submitted-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin-bottom: 12rpx;
}

.submitted-hint {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 36rpx;
  padding: 0 20rpx;
}

.submitted-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
  padding: 0 10rpx;
}

.submitted-actions .btn-secondary,
.submitted-actions .btn-primary {
  flex: 1;
}

/* 错误状态 */
.error-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f44336;
  color: #fff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 28rpx;
  color: #666;
  text-align: center;
}

/* 操作按钮 */
.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.actions .btn-secondary,
.actions .btn-primary {
  flex: 1;
}
