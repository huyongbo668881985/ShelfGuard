<!--pages/camera/camera.wxml-->
<view class="camera-page">
  <view class="approval-banner" wx:if="{{needsApproval}}">{{approvalBannerText}}</view>
  <!-- 相机预览区域 -->
  <view class="camera-wrapper" wx:if="{{!showPreview}}">
    <camera
      class="camera"
      device-position="{{devicePosition}}"
      flash="{{flashMode}}"
      resolution="high"
      binderror="onCameraError"
      bindinitdone="onCameraInitDone"
    >
      <!-- 实时水印预览层
           重要：camera 是原生组件，层级永远最高，普通 view/text 放在它里面
           或者用 CSS 定位盖在它上面，在开发者工具模拟器里能看起来正常，
           但真机上要么不显示、要么盖住了却收不到点击——必须用官方提供的
           cover-view / cover-image 才能正确覆盖在原生组件上面。 -->
      <cover-view class="watermark-preview">
        <!-- 顶部信息 -->
        <cover-view class="preview-top" wx:if="{{watermarkConfig.position === 'top' || watermarkConfig.position === 'full'}}">
          <cover-view class="preview-task">{{taskName || '未设置任务'}}</cover-view>
          <cover-view class="preview-store" wx:if="{{storeName}}">门店：{{storeName}}</cover-view>
          <cover-view class="preview-info">{{userName}} {{address}}</cover-view>
        </cover-view>

        <!-- 底部信息 -->
        <cover-view class="preview-bottom" wx:if="{{watermarkConfig.position === 'bottom'}}">
          <cover-view class="preview-task">{{taskName || '未设置任务'}}</cover-view>
          <cover-view class="preview-store" wx:if="{{storeName}}">门店：{{storeName}}</cover-view>
          <cover-view class="preview-info">{{userName}}  {{address}}</cover-view>
        </cover-view>
      </cover-view>

      <!-- 选择门店按钮：原来这里是「⚙️ 设置」。正常流程里门店在首页 / 「下一家」时就选好了，
           这里只是临时换一家时用的备用入口。必须是 cover-view 才能盖在原生相机上并接收点击。 -->
      <cover-view class="settings-btn" wx:if="{{recordType === 'visit'}}" bindtap="chooseCustomer">
        <cover-view>🏬 选择门店</cover-view>
      </cover-view>

      <!-- 连拍缩略图 + 完成按钮：拍1张时不强制拼图，多于1张才会在点"完成"后拼成一张大图 -->
      <cover-view class="capture-strip" wx:if="{{!showPreview}}">
        <cover-view class="capture-thumbs" wx:if="{{capturedPhotos.length > 0}}">
          <cover-view
            class="capture-thumb"
            wx:for="{{capturedPhotos}}"
            wx:key="*this"
            wx:for-index="idx"
            data-index="{{idx}}"
            bindtap="removeCapturedPhoto"
          >
            <cover-image class="capture-thumb-img" src="{{item}}"></cover-image>
            <cover-view class="capture-thumb-remove">✕</cover-view>
          </cover-view>
        </cover-view>

        <cover-view class="capture-count">已拍 {{capturedPhotos.length}}/{{maxPhotos}}</cover-view>

        <cover-view class="capture-finish-btn" wx:if="{{capturedPhotos.length > 0}}" bindtap="finishCapture">
          <cover-view wx:if="{{capturedPhotos.length <= 1}}">完成</cover-view>
          <cover-view wx:elif="{{imageMode === 'quality'}}">完成上传（精度）</cover-view>
          <cover-view wx:else>完成拼图</cover-view>
        </cover-view>
      </cover-view>
    </camera>

  </view>

  <!-- 相机控制栏：从 camera-wrapper 里移出来，作为 camera-page 的直接子节点。
       原因：下面把 .camera 改成 position:absolute 绝对填充预览区，若控制栏还
       留在 wrapper 内会和相机原生层重叠被遮挡；移到外层正常文档流就稳定可见。 -->
  <view class="camera-controls" wx:if="{{!showPreview}}">
    <view class="control-btn" bindtap="switchFlash">
      <text class="control-icon">{{flashMode === 'on' ? '⚡️' : flashMode === 'off' ? '🔦' : '⚡️'}}</text>
      <text class="control-label">{{flashMode === 'on' ? '开' : flashMode === 'off' ? '关' : '自动'}}</text>
    </view>

    <view class="shutter-btn" bindtap="takePhoto">
      <view class="shutter-inner"></view>
    </view>

    <view class="control-btn" bindtap="switchCamera">
      <text class="control-icon">🔄</text>
      <text class="control-label">翻转</text>
    </view>
  </view>


  <!-- 照片预览区域：精度模式多图可滑，并标明共 N 张 -->
  <view class="preview-wrapper" wx:if="{{showPreview}}">
    <block wx:if="{{watermarkedPaths.length > 1}}">
      <swiper
        class="preview-swiper"
        current="{{previewIndex}}"
        bindchange="onPreviewSwiperChange"
        indicator-dots="{{true}}"
        indicator-color="rgba(255,255,255,0.35)"
        indicator-active-color="#fff"
      >
        <swiper-item wx:for="{{watermarkedPaths}}" wx:key="*this">
          <image class="preview-image" src="{{item}}" mode="aspectFit"></image>
        </swiper-item>
      </swiper>
      <view class="preview-count-badge">共 {{watermarkedPaths.length}} 张 · 第 {{previewIndex + 1}} 张</view>
      <scroll-view class="preview-thumbs" scroll-x="{{true}}" enable-flex="{{true}}">
        <view
          class="preview-thumb {{previewIndex === index ? 'active' : ''}}"
          wx:for="{{watermarkedPaths}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onSelectPreviewThumb"
        >
          <image class="preview-thumb-img" src="{{item}}" mode="aspectFill"></image>
        </view>
      </scroll-view>
    </block>
    <block wx:else>
      <image
        class="preview-image"
        src="{{watermarkedPath || photoTempPath}}"
        mode="aspectFit"
      ></image>
    </block>

    <!-- 合成中提示 -->
    <view class="composing-mask" wx:if="{{composing}}">
      <text class="composing-text">正在添加水印...</text>
    </view>

    <!-- 操作按钮 -->
    <view class="preview-actions">
      <button class="btn-secondary" bindtap="retakePhoto">重新拍照</button>
      <button class="btn-primary" bindtap="confirmPhoto" disabled="{{composing}}">
        {{confirmBtnText}}
      </button>
    </view>
  </view>

  <!-- 隐藏的水印合成组件：始终挂载（组件自身用 CSS 移出屏幕外隐藏），
       不要用 wx:if 控制显隐——setData 是异步的，拍照后立即调用 composeWatermark()
       时组件可能还没被创建，selectComponent 会拿到 null 导致"水印组件未找到" -->
  <watermark-canvas id="watermarkCanvas"></watermark-canvas>

  <!-- 隐藏的拼图合成组件，同样始终挂载，原因跟上面一样 -->
  <photo-grid-canvas id="photoGridCanvas"></photo-grid-canvas>

  <!-- 隐私授权弹窗：首次触发相机/位置等敏感接口时由 app.js 全局拦截唤起，
       用户点"同意并继续"后放行被拦截的接口。平时隐藏。 -->
  <privacy-auth id="privacyAuth"></privacy-auth>
</view>
