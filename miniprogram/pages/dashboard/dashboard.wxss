/* pages/dashboard/dashboard.wxss */
.dash-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 24rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.month-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.month-picker {
  flex: 1;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: var(--shadow-sm);
}

.month-picker.secondary {
  opacity: 0.95;
}

.month-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.month-value {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.month-arrow {
  color: var(--color-text-hint);
  font-size: 24rpx;
}

.hint-card {
  background: #FFF8E8;
  color: #8A6D3B;
  padding: 24rpx;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.hero-card {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: #fff;
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  margin-bottom: 20rpx;
}

.hero-label {
  font-size: 26rpx;
  opacity: 0.85;
}

.hero-value-row {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  margin: 12rpx 0;
}

.hero-value {
  font-size: 80rpx;
  font-weight: 700;
  line-height: 1;
}

.hero-unit {
  font-size: 32rpx;
  margin-bottom: 12rpx;
}

.hero-sub {
  font-size: 22rpx;
  opacity: 0.75;
}

.cmp-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.cmp-card {
  flex: 1;
  min-width: 200rpx;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.cmp-title {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.cmp-ym {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin: 6rpx 0 12rpx;
}

.cmp-delta {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.cmp-delta.up { color: var(--color-success); }
.cmp-delta.down { color: var(--color-error); }

.cmp-base {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat-chip {
  flex: 1;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.stat-num.warn { color: var(--color-warning); }

.stat-lab {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.section-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-action {
  font-size: 26rpx;
  color: var(--color-primary);
}

.store-picked {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-bg-hover);
  border-radius: var(--radius-sm);
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.store-name {
  font-size: 28rpx;
  font-weight: 500;
}

.store-clear {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.store-empty {
  font-size: 26rpx;
  color: var(--color-text-hint);
  line-height: 1.5;
  padding: 8rpx 0 12rpx;
}

.store-hero {
  text-align: center;
  padding: 12rpx 0 8rpx;
}

.store-share {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.store-share-lab {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.store-cmp {
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.store-cmp .dot {
  margin: 0 12rpx;
  color: var(--color-text-hint);
}

.trend-scroll {
  white-space: nowrap;
  margin-top: 8rpx;
}

.trend-row {
  display: inline-flex;
  gap: 12rpx;
}

.trend-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
  padding: 16rpx 12rpx;
  background: var(--color-bg-page);
  border-radius: var(--radius-sm);
}

.trend-ym {
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.trend-val {
  font-size: 28rpx;
  font-weight: 600;
  margin: 8rpx 0;
  color: var(--color-text-primary);
}

.trend-visits {
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.action-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  width: 100%;
}

.footnote {
  font-size: 22rpx;
  color: var(--color-text-hint);
  line-height: 1.5;
  text-align: center;
  padding: 0 12rpx;
}

.stat-chip--clickable:active {
  background: var(--color-bg-hover, #F0F4F8);
}

/* 拜访不足 N 次门店交互抽屉 */
.lv-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 900;
}

.lv-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 82vh;
  z-index: 901;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.lv-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 34rpx 20rpx;
  border-bottom: 1rpx solid #EEF1F5;
}

.lv-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1C3D5A;
}

.lv-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #829AB1;
}

.lv-close {
  font-size: 36rpx;
  color: #9AA0A6;
  padding: 10rpx;
}

.lv-filters {
  padding: 20rpx 30rpx 16rpx;
  border-bottom: 1rpx solid #EEF1F5;
  background: #F8FAFC;
}

.lv-user-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.lv-user-row {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}

.lv-user-pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #486581;
  font-size: 24rpx;
  border: 1rpx solid #D9E2EC;
  flex-shrink: 0;
}

.lv-user-pill.active {
  background: #1C3D5A;
  color: #fff;
  border-color: #1C3D5A;
  font-weight: 600;
}

.lv-search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid #E4E7EB;
}

.lv-search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  color: #9AA0A6;
}

.lv-search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1F2933;
}

.lv-search-clear {
  font-size: 26rpx;
  color: #9AA0A6;
  padding: 0 8rpx;
}

.lv-list-scroll {
  flex: 1;
  max-height: 50vh;
  padding: 16rpx 30rpx;
  box-sizing: border-box;
}

.lv-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #EEF1F5;
}

.lv-item:last-child {
  border-bottom: none;
}

.lv-item-main {
  flex: 1;
  min-width: 0;
}

.lv-item-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.lv-store-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2933;
}

.lv-visit-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #FFF4E0;
  color: #B26A00;
  font-weight: 600;
}

.lv-item-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #627D98;
}

.lv-item-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.lv-act-btn {
  font-size: 22rpx;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  background: #EEF2F7;
  color: #1C3D5A;
  font-weight: 500;
}

.lv-act-btn.primary {
  background: #EBF4FF;
  color: #1D4ED8;
}

.lv-empty {
  padding: 60rpx 0;
  text-align: center;
  color: #9AA0A6;
  font-size: 26rpx;
}

.lv-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx 44rpx;
  border-top: 1rpx solid #EEF1F5;
  background: #fff;
}

.lv-footer-btn {
  flex: 1;
  margin: 0 !important;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.mat-user-scroll {
  margin-top: 12rpx;
  margin-bottom: 16rpx;
}

.mat-summary-row {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0 24rpx;
}

.mat-stat-box {
  flex: 1;
  background: #F8FAFC;
  border-radius: 14rpx;
  padding: 18rpx 12rpx;
  text-align: center;
  border: 1rpx solid #EEF1F5;
}

.mat-stat-num {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2933;
}

.mat-stat-num.ok {
  color: #2E7D32;
}

.mat-stat-num.warn {
  color: #D97706;
}

.mat-stat-pct {
  font-size: 22rpx;
  font-weight: 500;
}

.mat-stat-lab {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #627D98;
}

.mat-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.mat-item {
  background: #F8FAFC;
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #EEF1F5;
}

.mat-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.mat-item-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.mat-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2933;
}

.mat-item-cat {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #EEF2FF;
  color: #4338CA;
}

.mat-item-count {
  font-size: 24rpx;
  font-weight: 600;
  color: #1C3D5A;
  flex-shrink: 0;
}

.mat-bar-bg {
  height: 12rpx;
  border-radius: 999rpx;
  background: #E4E7EB;
  overflow: hidden;
}

.mat-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2563EB, #10B981);
}

.mat-tab-row {
  display: flex;
  background: #E4E7EB;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 16rpx;
}

.mat-tab-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #486581;
  border-radius: 10rpx;
}

.mat-tab-btn.active {
  background: #fff;
  color: #1C3D5A;
  font-weight: 700;
}
