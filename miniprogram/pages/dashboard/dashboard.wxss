/* pages/dashboard/dashboard.wxss */
.dash-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 24rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.month-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.month-picker {
  flex: 1;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: var(--shadow-sm);
}

.month-picker.secondary {
  opacity: 0.95;
}

.month-label {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.month-value {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.month-arrow {
  color: var(--color-text-hint);
  font-size: 24rpx;
}

.hint-card {
  background: #FFF8E8;
  color: #8A6D3B;
  padding: 24rpx;
  border-radius: var(--radius-md);
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.hero-card {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: #fff;
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  margin-bottom: 20rpx;
}

.hero-label {
  font-size: 26rpx;
  opacity: 0.85;
}

.hero-value-row {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  margin: 12rpx 0;
}

.hero-value {
  font-size: 80rpx;
  font-weight: 700;
  line-height: 1;
}

.hero-unit {
  font-size: 32rpx;
  margin-bottom: 12rpx;
}

.hero-sub {
  font-size: 22rpx;
  opacity: 0.75;
}

.cmp-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.cmp-card {
  flex: 1;
  min-width: 200rpx;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.cmp-title {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.cmp-ym {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin: 6rpx 0 12rpx;
}

.cmp-delta {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.cmp-delta.up { color: var(--color-success); }
.cmp-delta.down { color: var(--color-error); }

.cmp-base {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat-chip {
  flex: 1;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.stat-num.warn { color: var(--color-warning); }

.stat-lab {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.section-card {
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-action {
  font-size: 26rpx;
  color: var(--color-primary);
}

.store-picked {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-bg-hover);
  border-radius: var(--radius-sm);
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.store-name {
  font-size: 28rpx;
  font-weight: 500;
}

.store-clear {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.store-empty {
  font-size: 26rpx;
  color: var(--color-text-hint);
  line-height: 1.5;
  padding: 8rpx 0 12rpx;
}

.store-hero {
  text-align: center;
  padding: 12rpx 0 8rpx;
}

.store-share {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.store-share-lab {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.store-cmp {
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
}

.store-cmp .dot {
  margin: 0 12rpx;
  color: var(--color-text-hint);
}

.trend-scroll {
  white-space: nowrap;
  margin-top: 8rpx;
}

.trend-row {
  display: inline-flex;
  gap: 12rpx;
}

.trend-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
  padding: 16rpx 12rpx;
  background: var(--color-bg-page);
  border-radius: var(--radius-sm);
}

.trend-ym {
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.trend-val {
  font-size: 28rpx;
  font-weight: 600;
  margin: 8rpx 0;
  color: var(--color-text-primary);
}

.trend-visits {
  font-size: 20rpx;
  color: var(--color-text-hint);
}

.action-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  width: 100%;
}

.footnote {
  font-size: 22rpx;
  color: var(--color-text-hint);
  line-height: 1.5;
  text-align: center;
  padding: 0 12rpx;
}
