<!--pages/dashboard/dashboard.wxml-->
<view class="dash-page">
  <view class="month-bar">
    <picker mode="date" fields="month" value="{{yearMonth}}-01" bindchange="onYearMonthChange">
      <view class="month-picker">
        <text class="month-label">统计月份</text>
        <text class="month-value">{{yearMonth}}</text>
        <text class="month-arrow">▾</text>
      </view>
    </picker>
    <picker mode="date" fields="month" value="{{compareYearMonth || yearMonth}}-01" bindchange="onCompareMonthChange">
      <view class="month-picker secondary">
        <text class="month-label">对比月</text>
        <text class="month-value">{{compareYearMonth || '可选'}}</text>
        <text class="month-arrow">▾</text>
      </view>
    </picker>
  </view>

  <view class="hint-card" wx:if="{{empty && !loading}}">
    <text>该月暂无预计算数据。管理员可下拉刷新触发重建，或等待每晚 03:00 自动汇总。</text>
  </view>

  <view class="hero-card" wx:if="{{overall}}">
    <view class="hero-label">整体平均排面</view>
    <view class="hero-value-row">
      <text class="hero-value">{{overall.avgSharePercent != null ? overall.avgSharePercent : '—'}}</text>
      <text class="hero-unit" wx:if="{{overall.avgSharePercent != null}}">%</text>
    </view>
    <view class="hero-sub">店月平均再平均 · 更新以夜间汇总为准</view>
  </view>

  <view class="cmp-grid" wx:if="{{overall}}">
    <view class="cmp-card">
      <text class="cmp-title">环比上月</text>
      <text class="cmp-ym">{{mom.compareYearMonth || '—'}}</text>
      <text class="cmp-delta {{mom.deltaPoints > 0 ? 'up' : mom.deltaPoints < 0 ? 'down' : ''}}">
        {{mom.available ? ((mom.deltaPoints > 0 ? '+' : '') + mom.deltaPoints + ' pt') : '暂无'}}
      </text>
      <text class="cmp-base" wx:if="{{mom.baselineSharePercent != null}}">对照 {{mom.baselineSharePercent}}%</text>
    </view>
    <view class="cmp-card">
      <text class="cmp-title">同比去年</text>
      <text class="cmp-ym">{{yoy.compareYearMonth || '—'}}</text>
      <text class="cmp-delta {{yoy.deltaPoints > 0 ? 'up' : yoy.deltaPoints < 0 ? 'down' : ''}}">
        {{yoy.available ? ((yoy.deltaPoints > 0 ? '+' : '') + yoy.deltaPoints + ' pt') : '暂无'}}
      </text>
      <text class="cmp-base" wx:if="{{yoy.baselineSharePercent != null}}">对照 {{yoy.baselineSharePercent}}%</text>
    </view>
    <view class="cmp-card" wx:if="{{vsMonth}}">
      <text class="cmp-title">对比所选月</text>
      <text class="cmp-ym">{{vsMonth.compareYearMonth}}</text>
      <text class="cmp-delta {{vsMonth.deltaPoints > 0 ? 'up' : vsMonth.deltaPoints < 0 ? 'down' : ''}}">
        {{vsMonth.available ? ((vsMonth.deltaPoints > 0 ? '+' : '') + vsMonth.deltaPoints + ' pt') : '暂无'}}
      </text>
      <text class="cmp-base" wx:if="{{vsMonth.baselineSharePercent != null}}">对照 {{vsMonth.baselineSharePercent}}%</text>
    </view>
  </view>

  <view class="stats-row" wx:if="{{overall}}">
    <view class="stat-chip">
      <text class="stat-num">{{overall.customerCount}}</text>
      <text class="stat-lab">拜访客户数</text>
    </view>
    <view class="stat-chip">
      <text class="stat-num">{{overall.avgVisitsPerCustomer != null ? overall.avgVisitsPerCustomer : '—'}}</text>
      <text class="stat-lab">店均拜访</text>
    </view>
    <view class="stat-chip stat-chip--clickable" bindtap="onTapLowVisit">
      <text class="stat-num warn">{{overall.lowVisitCount}}</text>
      <text class="stat-lab">拜访&lt;{{overall.lowVisitThreshold}}次 ›</text>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <text class="section-title">单店排面</text>
      <text class="section-action" bindtap="onPickStore">选择客户</text>
    </view>
    <view class="store-picked" wx:if="{{storeName}}">
      <text class="store-name">{{storeName}}</text>
      <text class="store-clear" bindtap="onClearStore">清除</text>
    </view>
    <view class="store-empty" wx:else>
      <text>从客户库选择门店后，查看该店各月排面、环比与同比</text>
    </view>

    <block wx:if="{{storeTrend}}">
      <view class="store-hero">
        <text class="store-share">{{storeTrend.current && storeTrend.current.avgSharePercent != null ? storeTrend.current.avgSharePercent + '%' : '—'}}</text>
        <text class="store-share-lab">本月平均排面</text>
      </view>
      <view class="store-cmp">
        <text>环比 {{storeTrend.mom.available ? ((storeTrend.mom.deltaPoints > 0 ? '+' : '') + storeTrend.mom.deltaPoints + ' pt') : '暂无'}}</text>
        <text class="dot">·</text>
        <text>同比 {{storeTrend.yoy.available ? ((storeTrend.yoy.deltaPoints > 0 ? '+' : '') + storeTrend.yoy.deltaPoints + ' pt') : '暂无'}}</text>
      </view>
      <scroll-view scroll-x class="trend-scroll">
        <view class="trend-row">
          <view class="trend-item" wx:for="{{storeTrend.series}}" wx:key="yearMonth">
            <text class="trend-ym">{{item.yearMonth}}</text>
            <text class="trend-val">{{item.avgSharePercent != null ? item.avgSharePercent + '%' : '—'}}</text>
            <text class="trend-visits">{{item.visitCount}}次</text>
          </view>
        </view>
      </scroll-view>
    </block>
  </view>

  <!-- 终端广告物料覆盖统计（如：业务员名下 200 家店，各有什么物料的有多少家） -->
  <view class="section-card" wx:if="{{materialStats}}">
    <view class="section-head">
      <text class="section-title">终端广告物料覆盖</text>
      <text class="section-action" wx:if="{{isManager}}" bindtap="goMaterialLibrary">管理物料库 ›</text>
    </view>

    <!-- 管理者可按业务员胶囊筛选（查看某业务员名下全部门店的物料覆盖） -->
    <scroll-view
      class="lv-user-scroll mat-user-scroll"
      scroll-x="true"
      enable-flex="true"
      wx:if="{{isManager && materialStats.salesGroups && materialStats.salesGroups.length > 0}}"
    >
      <view class="lv-user-row">
        <view
          class="lv-user-pill {{!materialUserFilter ? 'active' : ''}}"
          data-name=""
          bindtap="onSelectMaterialUser"
        >全部</view>
        <view
          class="lv-user-pill {{materialUserFilter === item.name ? 'active' : ''}}"
          wx:for="{{materialStats.salesGroups}}"
          wx:key="name"
          data-name="{{item.name}}"
          bindtap="onSelectMaterialUser"
        >{{item.name}} ({{item.totalStores}}家)</view>
      </view>
    </scroll-view>

    <!-- 核心覆盖指标：总客户数 / 已铺物料门店 / 未铺物料门店 -->
    <view class="mat-summary-row">
      <view class="mat-stat-box">
        <text class="mat-stat-num">{{materialStats.totalStores}}</text>
        <text class="mat-stat-lab">名下总门店</text>
      </view>
      <view class="mat-stat-box">
        <text class="mat-stat-num ok">{{materialStats.coveredStores}} <text class="mat-stat-pct">({{materialStats.overallCoveragePercent}}%)</text></text>
        <text class="mat-stat-lab">已有物料门店</text>
      </view>
      <view class="mat-stat-box">
        <text class="mat-stat-num warn">{{materialStats.uncoveredStores}}</text>
        <text class="mat-stat-lab">无物料空白店</text>
      </view>
    </view>

    <!-- 各物料覆盖明细列表 -->
    <view class="mat-list" wx:if="{{materialStats.materials && materialStats.materials.length > 0}}">
      <view
        class="mat-item"
        wx:for="{{materialStats.materials}}"
        wx:key="materialName"
        data-index="{{index}}"
        bindtap="onTapMaterialItem"
      >
        <view class="mat-item-head">
          <view class="mat-item-title-wrap">
            <text class="mat-item-name">{{item.materialName}}</text>
            <text class="mat-item-cat" wx:if="{{item.category}}">{{item.category}}</text>
          </view>
          <text class="mat-item-count">{{item.storeCount}} / {{materialStats.totalStores}} 家 ({{item.coveragePercent}}%) ›</text>
        </view>
        <view class="mat-bar-bg">
          <view class="mat-bar-fill" style="width: {{item.coveragePercent}}%;"></view>
        </view>
      </view>
    </view>

    <view class="store-empty" wx:else>
      <text>暂未录入或识别到广告物料。管理员可点右上角「管理物料库」新增标准物料名称。</text>
    </view>
  </view>

  <view class="action-row">
    <button class="btn-primary action-btn" bindtap="goPhotoDetail">照片明细</button>
    <button class="btn-secondary action-btn" wx:if="{{isManager}}" bindtap="onRebuild" loading="{{rebuilding}}">立即重建统计</button>
  </view>

  <view class="footnote">数据每天凌晨自动汇总一次；环比=上月，同比=去年同月。默认拜访不足阈值 N={{defaultN}}。</view>

  <!-- 拜访不足 N 次门店可交互抽屉 -->
  <view class="lv-mask" wx:if="{{showLowVisitModal}}" bindtap="closeLowVisitModal"></view>
  <view class="lv-panel {{showLowVisitModal ? 'show' : ''}}" wx:if="{{showLowVisitModal}}">
    <view class="lv-header">
      <view>
        <text class="lv-title">⚠️ 拜访不足 {{overall.lowVisitThreshold}} 次门店</text>
        <text class="lv-sub">{{yearMonth}} · 当前筛选共 {{lowVisitFiltered.length}} / {{overall.lowVisitCustomers.length}} 家</text>
      </view>
      <text class="lv-close" bindtap="closeLowVisitModal">✕</text>
    </view>

    <!-- 业务员胶囊筛选 + 搜索框 -->
    <view class="lv-filters">
      <scroll-view class="lv-user-scroll" scroll-x="true" enable-flex="true" wx:if="{{isManager && lowVisitUserGroups.length > 0}}">
        <view class="lv-user-row">
          <view
            class="lv-user-pill {{!lowVisitUserFilter ? 'active' : ''}}"
            data-name=""
            bindtap="onSelectLowVisitUser"
          >全部 ({{overall.lowVisitCustomers.length}})</view>
          <view
            class="lv-user-pill {{lowVisitUserFilter === item.name ? 'active' : ''}}"
            wx:for="{{lowVisitUserGroups}}"
            wx:key="name"
            data-name="{{item.name}}"
            bindtap="onSelectLowVisitUser"
          >{{item.name}} ({{item.count}})</view>
        </view>
      </scroll-view>

      <view class="lv-search-box">
        <text class="lv-search-icon">🔍</text>
        <input
          class="lv-search-input"
          placeholder="搜索门店名称或业务员"
          value="{{lowVisitKeyword}}"
          bindinput="onLowVisitKeywordInput"
        />
        <text class="lv-search-clear" wx:if="{{lowVisitKeyword}}" bindtap="onClearLowVisitKeyword">✕</text>
      </view>
    </view>

    <!-- 门店列表 -->
    <scroll-view class="lv-list-scroll" scroll-y="true">
      <view class="lv-item" wx:for="{{lowVisitFiltered}}" wx:key="customerId">
        <view class="lv-item-main">
          <view class="lv-item-top">
            <text class="lv-store-name">{{index + 1}}. {{item.storeName || item.customerId}}</text>
            <text class="lv-visit-badge">已访 {{item.visitCount}} 次 · 差 {{item.lackCount}} 次</text>
          </view>
          <view class="lv-item-meta">
            <text wx:if="{{item.userName}}">👤 {{item.userName}}</text>
            <text wx:if="{{item.avgSharePercent != null}}"> · 排面 {{item.avgSharePercent}}%</text>
            <text wx:if="{{item.lastScore != null}}"> · 最近 {{item.lastScore}}分</text>
            <text wx:if="{{item.lastVisitDate}}"> · 上次 {{item.lastVisitDate}}</text>
          </view>
        </view>
        <view class="lv-item-actions">
          <view
            class="lv-act-btn"
            data-id="{{item.customerId}}"
            data-name="{{item.storeName || item.customerId}}"
            bindtap="onInspectLowVisitTrend"
          >📈 趋势</view>
          <view
            class="lv-act-btn primary"
            data-id="{{item.customerId}}"
            data-name="{{item.storeName || item.customerId}}"
            bindtap="onInspectLowVisitPhotos"
          >🖼️ 照片</view>
        </view>
      </view>

      <view class="lv-empty" wx:if="{{lowVisitFiltered.length === 0}}">
        <text>没有匹配的门店</text>
      </view>
    </scroll-view>

    <view class="lv-footer">
      <button class="btn-secondary lv-footer-btn" bindtap="closeLowVisitModal">关闭</button>
      <button class="btn-primary lv-footer-btn" bindtap="copyLowVisitList">📋 复制未达标名单发群</button>
    </view>
  </view>

  <!-- 广告物料门店明细抽屉（已铺设 vs 未铺设门店） -->
  <view class="lv-mask" wx:if="{{showMaterialModal}}" bindtap="closeMaterialModal"></view>
  <view class="lv-panel {{showMaterialModal ? 'show' : ''}}" wx:if="{{showMaterialModal && activeMaterial}}">
    <view class="lv-header">
      <view>
        <text class="lv-title">🪧 {{activeMaterial.materialName}}</text>
        <text class="lv-sub">覆盖 {{activeMaterial.storeCount}} / {{activeMaterial.totalStores}} 家门店（{{activeMaterial.coveragePercent}}%）</text>
      </view>
      <text class="lv-close" bindtap="closeMaterialModal">✕</text>
    </view>

    <view class="lv-filters">
      <view class="mat-tab-row">
        <view
          class="mat-tab-btn {{materialModalTab === 'with' ? 'active' : ''}}"
          data-tab="with"
          bindtap="onSwitchMaterialModalTab"
        >已铺设 ({{activeMaterial.storeCount}}家)</view>
        <view
          class="mat-tab-btn {{materialModalTab === 'without' ? 'active' : ''}}"
          data-tab="without"
          bindtap="onSwitchMaterialModalTab"
        >未铺设 ({{activeMaterial.missingStoreCount}}家)</view>
      </view>

      <view class="lv-search-box">
        <text class="lv-search-icon">🔍</text>
        <input
          class="lv-search-input"
          placeholder="搜索门店名称或业务员"
          value="{{materialModalKeyword}}"
          bindinput="onMaterialModalKeywordInput"
        />
      </view>
    </view>

    <scroll-view class="lv-list-scroll" scroll-y="true">
      <view class="lv-item" wx:for="{{materialModalList}}" wx:key="index">
        <view class="lv-item-main">
          <view class="lv-item-top">
            <text class="lv-store-name">{{index + 1}}. {{item.storeName}}</text>
            <text class="lv-visit-badge" wx:if="{{materialModalTab === 'with'}}">{{item.condition || '完好'}} · {{item.count || 1}}处</text>
          </view>
          <view class="lv-item-meta">
            <text wx:if="{{item.userName}}">👤 {{item.userName}}</text>
          </view>
        </view>
        <view class="lv-item-actions" wx:if="{{item.customerId}}">
          <view
            class="lv-act-btn primary"
            data-id="{{item.customerId}}"
            data-name="{{item.storeName}}"
            bindtap="onInspectMaterialStorePhotos"
          >🖼️ 照片</view>
        </view>
      </view>

      <view class="lv-empty" wx:if="{{materialModalList.length === 0}}">
        <text>没有匹配的门店</text>
      </view>
    </scroll-view>

    <view class="lv-footer">
      <button class="btn-secondary lv-footer-btn" bindtap="closeMaterialModal">关闭</button>
      <button class="btn-primary lv-footer-btn" bindtap="copyMaterialStoreList">
        📋 复制{{materialModalTab === 'with' ? '已铺设' : '未铺设'}}名单
      </button>
    </view>
  </view>
</view>
