<!--pages/report/report.wxml-->
<wxs module="tools">
  function getComplianceColor(score) {
    if (!score && score !== 0) return '#4caf50';
    if (score >= 80) return '#2e7d32';
    if (score >= 60) return '#ff9800';
    return '#f44336';
  }
  module.exports = {
    getComplianceColor: getComplianceColor
  };
</wxs>

<view class="report-page">
  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <block wx:if="{{!loading && detail}}">
    <!-- 状态栏 -->
    <view class="status-bar status-{{detail.status}}">
      <text class="status-icon">✓</text>
      <text class="status-text">
        <block wx:if="{{detail.status === 'analyzed'}}">已完成</block>
        <block wx:elif="{{detail.status === 'clocked'}}">已打卡</block>
        <block wx:else>已提交</block>
      </text>
    </view>

    <!-- 基本信息 -->
    <view class="card info-section">
      <view class="section-title">拜访信息</view>
      <view class="info-row">
        <text class="info-label">任务名称</text>
        <text class="info-value">{{detail.taskName || '未填写'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">门店名称</text>
        <text class="info-value">{{detail.storeName || '未填写'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">业务员</text>
        <text class="info-value">{{detail.userName || '未设置'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">拜访时间</text>
        <text class="info-value">{{detail.createdAtFormatted}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">位置</text>
        <text class="info-value">{{detail.location.address || '未知'}}</text>
      </view>
    </view>

    <!-- 陈列照片 -->
    <view class="card photo-section">
      <view class="photo-section-header">
        <view class="section-title">陈列照片 ({{detail.photoCount || 1}}张)</view>
        <view class="photo-quick-actions" wx:if="{{detail.photoURLs && detail.photoURLs.length > 0}}">
          <text class="quick-action-btn" data-url="{{detail.photoURLs[currentPhotoIndex] || detail.photoURLs[0]}}" bindtap="sharePhoto">📤 发当前</text>
          <text class="quick-action-btn" data-url="{{detail.photoURLs[currentPhotoIndex] || detail.photoURLs[0]}}" bindtap="savePhoto">💾 存当前</text>
          <text class="quick-action-btn" wx:if="{{detail.photoURLs.length > 1}}" bindtap="saveAllPhotos">📚 全部存</text>
          <text class="photo-index-hint" wx:if="{{detail.photoURLs.length > 1}}">第 {{currentPhotoIndex + 1}}/{{detail.photoURLs.length}} 张</text>
        </view>
      </view>
      <view class="photo-grid">
        <image
          wx:for="{{detail.photoURLs}}"
          wx:key="index"
          class="photo-item {{currentPhotoIndex === index ? 'photo-item-active' : ''}}"
          src="{{(detail.photoThumbURLs && detail.photoThumbURLs[index]) || item}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          data-url="{{item}}"
          data-index="{{index}}"
          bindtap="onSelectPhoto"
        />
      </view>
    </view>

    <!-- AI 分析报告 -->
    <block wx:if="{{detail.aiReport}}">
      <!-- 照片质量 / 局部取景温和提醒（不阻断） -->
      <view class="quality-notice-card" wx:if="{{reportView.qualityNotices && reportView.qualityNotices.length > 0}}">
        <view class="quality-notice-body">
          <text class="quality-notice-title">💡 拍摄与取景提示</text>
          <text class="quality-notice-text" wx:for="{{reportView.qualityNotices}}" wx:key="index">{{item}}</text>
        </view>
        <view class="quality-notice-actions">
          <text class="quality-action-link" bindtap="retryAnalysis">重新分析</text>
          <text class="quality-action-sep">·</text>
          <text class="quality-action-link" bindtap="goToCamera">再拍一张</text>
        </view>
      </view>

      <!-- 评分卡片 -->
      <view class="card score-card">
        <view
          wx:if="{{reportView.scoreState === 'scored'}}"
          class="score-circle score-{{detail.aiReport.score >= 80 ? 'high' : detail.aiReport.score >= 60 ? 'mid' : 'low'}}"
        >
          <text class="score-number">{{detail.aiReport.score}}</text>
          <text class="score-level">{{detail.aiReport.scoreLevel || ''}}</text>
        </view>
        <view
          wx:elif="{{reportView.scoreState === 'out_of_stock'}}"
          class="score-circle score-oos"
        >
          <text class="score-status-tag">未上柜</text>
          <text class="score-level">不计均分</text>
        </view>
        <view
          wx:elif="{{reportView.scoreState === 'no_shelf'}}"
          class="score-circle score-noshelf"
        >
          <text class="score-status-tag">无货架照</text>
          <text class="score-level">不计均分</text>
        </view>
        <view wx:else class="score-circle score-noshelf">
          <text class="score-status-tag">--</text>
          <text class="score-level">{{detail.aiReport.scoreLevel || '待评估'}}</text>
        </view>
        <view class="score-summary">
          <text class="summary-text">{{detail.aiReport.summary}}</text>
        </view>
      </view>

      <!-- 独立核心指标：陈列排面 -->
      <view class="card facing-metrics-card" wx:if="{{reportView.facingSummary}}">
        <view class="facing-head">
          <text class="section-title facing-title">陈列排面（核心指标）</text>
          <text
            wx:if="{{reportView.facingSummary.confidenceLabel}}"
            class="facing-conf conf-{{reportView.facingSummary.confidenceLevel}}"
          >{{reportView.facingSummary.confidenceLabel}}</text>
        </view>
        <view class="facing-grid">
          <view class="facing-cell">
            <text class="facing-val">{{reportView.facingSummary.ownFacingCount}}<text class="facing-unit">面</text></text>
            <text class="facing-lab">我方总排面</text>
          </view>
          <view class="facing-divider"></view>
          <view class="facing-cell">
            <text class="facing-val">{{reportView.facingSummary.ownSkuCount}}<text class="facing-unit" wx:if="{{reportView.facingSummary.ownSkuCount !== '--'}}">个</text></text>
            <text class="facing-lab">在架品规</text>
          </view>
          <view class="facing-divider"></view>
          <view class="facing-cell">
            <text class="facing-val">{{reportView.facingSummary.ownFacingShare}}</text>
            <text class="facing-lab">排面占比</text>
          </view>
        </view>
      </view>

      <!-- 陈列规范度评分（新 5 维 / 旧 6 维双兼容） -->
      <view class="card compliance-card" wx:if="{{reportView.complianceList && reportView.complianceList.length > 0}}">
        <view class="section-title">
          {{reportView.isV2 ? '陈列质量评分明细（5维 · 满分100）' : '陈列规范度'}}
        </view>
        <view class="compliance-list">
          <view class="compliance-item" wx:for="{{reportView.complianceList}}" wx:key="key">
            <view class="compliance-header">
              <text class="compliance-name">{{item.name}}</text>
              <text class="compliance-score" style="color: {{item.color}}">{{item.scoreText}}</text>
            </view>
            <view class="compliance-bar">
              <view class="compliance-fill" style="width: {{item.percent}}%; background: {{item.color}}"></view>
            </view>
            <text class="compliance-detail" wx:if="{{item.detail}}">{{item.detail}}</text>
          </view>
        </view>
      </view>

      <!-- 识别到的产品 -->
      <view class="card products-card" wx:if="{{detail.aiReport.productIdentification.length > 0}}">
        <view class="section-title">识别产品 ({{detail.aiReport.productIdentification.length}})</view>
        <view class="product-list">
          <view class="product-item" wx:for="{{detail.aiReport.productIdentification}}" wx:key="index">
            <view class="product-main">
              <text class="product-brand">{{item.brand}}</text>
              <text class="product-line" wx:if="{{item.productLine}}">{{item.productLine}}</text>
            </view>
            <view class="product-meta">
              <text class="product-tag">{{item.aromaType}}</text>
              <text class="product-tag">{{item.priceRange}}</text>
              <text class="product-facing" wx:if="{{item.facingCount}}">{{item.facingCount}}面</text>
            </view>
            <view class="product-position" wx:if="{{item.position}}">
              <text class="position-text">{{item.position}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 识别到的广告物料 -->
      <view class="card products-card" wx:if="{{detail.aiReport.adMaterials && detail.aiReport.adMaterials.length > 0}}">
        <view class="section-title">识别广告物料 ({{detail.aiReport.adMaterials.length}})</view>
        <view class="product-list">
          <view class="product-item" wx:for="{{detail.aiReport.adMaterials}}" wx:key="index">
            <view class="product-main">
              <text class="product-brand">{{item.name}}</text>
              <text class="product-line" wx:if="{{item.position}}">{{item.position}}</text>
            </view>
            <view class="product-meta">
              <text class="product-tag" wx:if="{{item.category}}">{{item.category}}</text>
              <text class="product-tag" wx:if="{{item.condition}}">{{item.condition}}</text>
              <text class="product-facing" wx:if="{{item.count}}">{{item.count}}处</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 竞品分析 -->
      <view class="card competitive-card" wx:if="{{detail.aiReport.competitiveAnalysis && detail.aiReport.competitiveAnalysis.brands.length > 0}}">
        <view class="section-title">竞品分析</view>
        <view class="competitive-insight" wx:if="{{detail.aiReport.competitiveAnalysis.insight}}">
          <text>{{detail.aiReport.competitiveAnalysis.insight}}</text>
        </view>
        <view class="brand-share-list">
          <view class="brand-share-item" wx:for="{{detail.aiReport.competitiveAnalysis.brands}}" wx:key="brand">
            <text class="brand-name">{{item.brand}}</text>
            <view class="brand-bar-wrapper">
              <view class="brand-bar" style="width: {{item.sharePercent}}%"></view>
            </view>
            <text class="brand-percent">{{item.sharePercent}}%</text>
          </view>
        </view>
      </view>

      <!-- 问题列表 -->
      <view class="card issues-card" wx:if="{{detail.aiReport.issues.length > 0}}">
        <view class="section-title">发现问题 ({{detail.aiReport.issues.length}})</view>
        <view class="issue-list">
          <view class="issue-item issue-{{item.severity || 'medium'}}" wx:for="{{detail.aiReport.issues}}" wx:key="index">
            <view class="issue-header">
              <text class="issue-severity">
                {{item.severity === 'high' ? '严重' : item.severity === 'medium' ? '中等' : '轻微'}}
              </text>
              <text class="issue-category">{{item.category}}</text>
            </view>
            <text class="issue-desc">{{item.description}}</text>
            <text class="issue-impact" wx:if="{{item.impact}}">影响：{{item.impact}}</text>
          </view>
        </view>
      </view>

      <!-- 改进建议 -->
      <view class="card suggestions-card" wx:if="{{detail.aiReport.suggestions.length > 0}}">
        <view class="section-title">改进建议 ({{detail.aiReport.suggestions.length}})</view>
        <view class="suggestion-list">
          <view class="suggestion-item suggestion-{{item.priority || 'medium'}}" wx:for="{{detail.aiReport.suggestions}}" wx:key="index">
            <view class="suggestion-header">
              <text class="suggestion-priority">
                {{item.priority === 'high' ? '高优先' : item.priority === 'medium' ? '中优先' : '低优先'}}
              </text>
              <text class="suggestion-deadline" wx:if="{{item.deadline}}">{{item.deadline}}</text>
            </view>
            <text class="suggestion-action">{{item.action}}</text>
            <text class="suggestion-effect" wx:if="{{item.expectedEffect}}">预期效果：{{item.expectedEffect}}</text>
          </view>
        </view>
      </view>


      <!-- 日报聚合说明：本页详情来自当日汇总投影，非单店深度分析 -->
      <view class="mock-badge daily-badge" wx:if="{{detail.aiReport.metadata.isDailySummary}}">
        <text>📋 本报告来自日报聚合（{{detail.aiReport.metadata.dailyDate || '当日'}}），非单店深度分析</text>
      </view>

      <!-- 模拟报告标记 -->
      <view class="mock-badge" wx:if="{{false}}">
        <text>⚠️ 此为模拟报告，请配置 AI API Key 获取真实分析</text>
      </view>
    </block>

    <!-- AI 分析中 / 排队中 / 打卡提示 -->
    <view class="card analyzing-card" wx:if="{{!detail.aiReport && (detail.status === 'pending' || detail.status === 'uploaded' || detail.status === 'analyzing' || detail.status === 'analyze_failed' || detail.status === 'clocked')}}">
      <text class="analyzing-icon">✓</text>
      <text class="analyzing-text">
        {{detail.status === 'clocked' ? '打卡完成' : '已提交'}}
      </text>
      <text class="analyzing-hint">
        {{detail.status === 'clocked' ? '上下班考勤打卡及定位已记录' : '照片已提交成功，可以继续拜访下一家'}}
      </text>
      </view>

    <!-- 分析失败：对业务员隐藏，管理员可在「分析设置」里重新分析 -->
    <view class="card fail-card" wx:if="{{false}}">
      <text class="fail-icon">!</text>
      <text class="fail-text">AI 分析失败</text>
      <text class="fail-error" wx:if="{{detail.analyzeError}}">{{detail.analyzeError}}</text>
      <button class="btn-primary refresh-btn" bindtap="retryAnalysis">重新进行 AI 分析</button>
    </view>

    <!-- 底部操作栏：报告页是流程的终点，之前没有明确的下一步入口，
         只能靠系统默认的返回箭头退出，这里补上"再拍一张"和"查看历史"两个出口 -->
    <view class="bottom-actions">
      <button class="btn-outline" bindtap="goToHistory">查看历史</button>
      <button class="btn-primary" bindtap="goToCamera">再拍一张</button>
    </view>
  </block>
</view>

<privacy-auth id="privacyAuth"></privacy-auth>
