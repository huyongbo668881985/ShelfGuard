<!--pages/settings/settings.wxml-->
<view class="settings-page">
  <!-- 品牌头 -->
  <view class="brand-header brand-header--full">
    <view class="brand-logo">特8水印</view>
    <view class="brand-sub">终端拜访 · 真实水印</view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 只读提示（管理者） -->
    <view class="readonly-tip" wx:if="{{!canEdit && isManager}}">
      <text>你是管理者，以下设置仅供查看，修改请联系管理员</text>
    </view>

    <!-- 首管理员激活（仅当系统尚无管理员、且当前用户不是管理员时显示） -->
    <view class="card activate-card" wx:if="{{showActivate}}">
      <view class="section-title">激活管理员</view>
      <text class="activate-desc">系统还没有管理员。输入部署时配置的激活码，把你当前的微信账号设为管理员；之后就能在「用户与权限管理」里给其他人分配角色。</text>
      <input
        class="activate-input"
        placeholder="请输入激活码"
        placeholder-class="key-input-ph"
        value="{{activateCode}}"
        bindinput="onActivateInput"
      />
      <button class="btn-primary activate-btn" bindtap="onActivate" disabled="{{activating}}">
        {{activating ? '激活中...' : '激活为管理员'}}
      </button>
    </view>

    <!-- 管理后台入口（仅管理员可见） -->
    <view class="card admin-entry" wx:if="{{canEdit}}" bindtap="goAdmin">
      <view class="entry-left">
        <text class="entry-title">用户与权限管理</text>
        <text class="entry-sub">批准新人、分配角色、修改姓名、绑定进销存业务员、停用离职账号</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <!-- 以下内容只对管理员 / 管理者显示（系统无管理员时，非管理者进来只看到激活卡片） -->
    <block wx:if="{{isManager}}">

    <!-- 客户管理 / 产品库（原来在拍照页「⚙️ 设置」里） -->
    <view class="card admin-entry" bindtap="goCustomers">
      <view class="entry-left">
        <text class="entry-title">客户管理</text>
        <text class="entry-sub">查看和编辑全部客户（门店）资料</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>
    <view class="card admin-entry" bindtap="goProducts">
      <view class="entry-left">
        <text class="entry-title">产品库</text>
        <text class="entry-sub">管理品牌产品资料</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>

    <!-- 未分配的客户：进销存同步时没对上业务员，暂时归在管理员名下（管理员 / 管理者可看） -->
    <view class="card" wx:if="{{unassignedLoaded}}">
      <view class="section-title">未分配的客户（{{unassignedTotal}}）</view>
      <view class="form-hint" wx:if="{{unassignedPendingSync > 0}}">
        <text>管理员点击「立即同步」后显示。</text>
      </view>
      <view class="form-hint" wx:elif="{{unassignedTotal === 0}}">
        <text>所有进销存客户都已分到业务员名下。</text>
      </view>
      <view class="unassigned-item" wx:for="{{unassigned}}" wx:key="_id">
        <text class="unassigned-name">{{item.storeName}}</text>
        <text class="unassigned-op">进销存业务员：{{item.jxcOperatorName || '（未填写）'}}</text>
      </view>
      <!-- 分页：每页 30 家，第一页禁用上一页、最后一页禁用下一页 -->
      <view class="unassigned-pager" wx:if="{{unassignedTotal > 0}}">
        <button class="btn-outline pager-btn" size="mini" bindtap="onPrevUnassigned" disabled="{{unassignedPage <= 1 || unassignedLoadingPage}}">上一页</button>
        <text class="unassigned-count">第 {{unassignedPage}} / {{unassignedTotalPages}} 页，共 {{unassignedTotal}} 家</text>
        <button class="btn-outline pager-btn" size="mini" bindtap="onNextUnassigned" disabled="{{unassignedPage >= unassignedTotalPages || unassignedLoadingPage}}">下一页</button>
      </view>
      <view class="form-hint" wx:if="{{unassignedTotal > 0}}">
        <text>处理方法：在「用户与权限管理」里把对应业务员的姓名改成和进销存一致，或用「绑定进销存」手动对应（重名的也用它区分）。改完后下一次同步自动分过去。</text>
      </view>
    </view>

    <!-- 队列概览：admin/manager 看团队；sales 只看自己 -->
    <view class="card queue-card">
      <view class="section-title">{{queueScopeLabel}}</view>
      <view class="queue-row">
        <view class="queue-item">
          <text class="queue-value queue-pending">{{queue.pending}}</text>
          <text class="queue-label">待分析</text>
        </view>
        <view class="queue-divider"></view>
        <view class="queue-item">
          <text class="queue-value queue-running">{{queue.analyzing}}</text>
          <text class="queue-label">分析中</text>
        </view>
        <view class="queue-divider"></view>
        <view class="queue-item">
          <text class="queue-value queue-failed">{{queue.failed}}</text>
          <text class="queue-label">失败</text>
        </view>
      </view>

      <view class="last-run" wx:if="{{lastRunText}}">
        <text class="last-run-title">上次运行：{{lastRunText}}</text>
        <text class="last-run-detail" wx:if="{{lastRunSummaryText}}">{{lastRunSummaryText}}</text>
      </view>

      <view class="queue-actions">
        <button class="btn-outline" bindtap="onRetryFailed" disabled="{{!canEdit}}">重排失败/卡住</button>
        <button class="btn-primary" bindtap="onRunNow" disabled="{{!canEdit || running}}">
          {{running ? '分析中...' : '立即分析一批'}}
        </button>
      </view>
    </view>

    <!-- 分析模式 -->
    <view class="card">
      <view class="section-title">分析模式</view>

      <view class="mode-option {{analyzeMode === 'batch' ? 'active' : ''}}" data-mode="batch" bindtap="onSelectMode">
        <view class="mode-head">
          <text class="mode-name">每日集中分析</text>
          <text class="mode-check" wx:if="{{analyzeMode === 'batch'}}">✓</text>
        </view>
        <text class="mode-desc">照片提交后立刻显示"已提交"，业务员直接去下一家。AI 分析统一在设定时间跑，不占用拜访时间。</text>
      </view>

      <view class="mode-option {{analyzeMode === 'instant' ? 'active' : ''}}" data-mode="instant" bindtap="onSelectMode">
        <view class="mode-head">
          <text class="mode-name">提交即分析</text>
          <text class="mode-check" wx:if="{{analyzeMode === 'instant'}}">✓</text>
        </view>
        <text class="mode-desc">旧流程。提交后原地等待 AI 出结果，约 15-40 秒，随后直接跳转报告页。</text>
      </view>
    </view>


    <!-- 识别精度 vs 流量 -->
    <view class="card">
      <view class="section-title">拍照上传策略</view>
      <view class="mode-option {{imageMode === 'traffic' ? 'active' : ''}}" data-mode="traffic" bindtap="onSelectImageMode">
        <view class="mode-head">
          <text class="mode-name">流量优先</text>
          <text class="mode-check" wx:if="{{imageMode === 'traffic'}}">✓</text>
        </view>
        <text class="mode-desc">多张照片拼成一张网格图再上传，省流量、省 AI 调用成本。默认推荐。</text>
      </view>
      <view class="mode-option {{imageMode === 'quality' ? 'active' : ''}}" data-mode="quality" bindtap="onSelectImageMode">
        <view class="mode-head">
          <text class="mode-name">识别精度优先</text>
          <text class="mode-check" wx:if="{{imageMode === 'quality'}}">✓</text>
        </view>
        <text class="mode-desc">跳过拼图，多张原图各自全分辨率上传后合并分析，价签/品牌更清晰，流量与费用更高。</text>
      </view>
      <text class="form-tip" style="padding: 0 8rpx;">由管理员统一设置，点「保存设置」后对全员生效，业务员下次打开拍照页自动使用。</text>
    </view>

    <!-- 集中分析时间 -->
    <view class="card" wx:if="{{analyzeMode === 'batch'}}">
      <view class="section-title">集中分析时间</view>

      <view class="form-row">
        <text class="form-label">开始时间</text>
        <picker mode="time" value="{{analyzeTime}}" bindchange="onTimeChange" disabled="{{!canEdit}}">
          <view class="form-picker">
            <text>{{analyzeTime}}</text>
            <text class="form-arrow">›</text>
          </view>
        </picker>
      </view>

      <view class="form-row">
        <text class="form-label">持续时长</text>
        <view class="form-input-wrap">
          <input
            class="form-input"
            type="number"
            value="{{windowMinutes}}"
            bindinput="onWindowInput"
            disabled="{{!canEdit}}"
          />
          <text class="form-unit">分钟</text>
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">每轮处理</text>
        <view class="form-input-wrap">
          <input
            class="form-input"
            type="number"
            value="{{batchSize}}"
            bindinput="onBatchSizeInput"
            disabled="{{!canEdit}}"
          />
          <text class="form-unit">条</text>
        </view>
      </view>

      <view class="form-hint">
        <text>系统每 2 分钟检查一次，在「{{analyzeTime}} 起 {{windowMinutes}} 分钟」这个窗口内，每次最多处理 {{batchSize}} 条。窗口结束时没排完的记录会留到第二天继续。</text>
      </view>
    </view>

    <!-- API Key -->
    <view class="card">
      <view class="section-title">通义千问 API Key</view>

      <view class="key-status" wx:if="{{hasApiKey}}">
        <text class="key-status-ok">已配置：{{apiKeyMasked}}</text>
        <text class="key-clear" bindtap="onClearApiKey" wx:if="{{canEdit}}">清除</text>
      </view>
      <view class="key-status" wx:else>
        <text class="key-status-none">此处未配置（也可能已写在服务器环境变量里）</text>
      </view>

      <input
        class="key-input"
        placeholder="{{hasApiKey ? '留空表示不修改' : '粘贴 sk- 开头的 API Key'}}"
        placeholder-class="key-input-ph"
        value="{{apiKeyInput}}"
        bindinput="onApiKeyInput"
        disabled="{{!canEdit}}"
      />

      <view class="form-hint">
        <text>推荐把 Key 配在服务器环境变量 DASHSCOPE_API_KEY（不经过小程序）。也可以填在上面，两处都配时以环境变量优先。</text>
        <text class="hint-line">Key 从阿里云百炼控制台 bailian.console.aliyun.com 申请。</text>
      </view>
    </view>

    <!-- 进销存 (jxc-app) 客户同步配置 -->
    <view class="card">
      <view class="section-title">进销存客户同步</view>

      <view class="form-row">
        <text class="form-label">服务地址</text>
        <view class="form-input-wrap form-input-wrap--wide">
          <input
            class="form-input form-input--wide"
            placeholder="例如 http://192.168.1.100:3000"
            value="{{jxcBaseUrl}}"
            bindinput="onJxcBaseUrlInput"
            disabled="{{!canEdit}}"
          />
        </view>
      </view>

      <view class="key-status" wx:if="{{hasJxcApiKey}}">
        <text class="key-status-ok">进销存 Key：{{jxcApiKeyMasked}}</text>
        <text class="key-clear" bindtap="onClearJxcApiKey" wx:if="{{canEdit}}">清除</text>
      </view>
      <view class="key-status" wx:else>
        <text class="key-status-none">尚未配置进销存 API Key</text>
      </view>

      <input
        class="key-input"
        placeholder="{{hasJxcApiKey ? '留空表示不修改' : '输入对应租户生成的 API Key'}}"
        placeholder-class="key-input-ph"
        value="{{jxcApiKeyInput}}"
        bindinput="onJxcApiKeyInput"
        disabled="{{!canEdit}}"
      />

      <view class="last-run" wx:if="{{jxcLastSyncText}}">
        <text class="last-run-title">上次同步：{{jxcLastSyncText}}</text>
        <text class="last-run-detail" wx:if="{{jxcLastSyncSummaryText}}">{{jxcLastSyncSummaryText}}</text>
      </view>

      <!-- 立即同步：只有管理员可见 -->
      <view class="queue-actions" wx:if="{{canEdit}}">
        <button class="btn-primary" bindtap="onManualSyncJxc" disabled="{{syncingJxc}}">
          {{syncingJxc ? '正在同步...' : '立即从进销存同步客户'}}
        </button>
      </view>

      <view class="form-hint">
        <text>云端已配置定时增量同步（每30分钟自动触发），管理员也可点上方按钮立即同步。同步时将自动通过业务员手机号或姓名归属到对应业务员，坐标留空并在业务员首次到店拜访时自动绑定。</text>
      </view>
    </view>

    <!-- 保存 -->
    <view class="save-bar" wx:if="{{canEdit}}">
      <button class="btn-primary btn-save" bindtap="onSave" disabled="{{saving}}">
        {{saving ? '保存中...' : '保存设置'}}
      </button>
    </view>
    </block>
  </block>
</view>
