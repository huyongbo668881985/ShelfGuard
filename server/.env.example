# 复制为 server/.env 后填写。不要把填好的 .env 提交到 git。

# 微信小程序（新主体 AppID）
WECHAT_APPID=wxd60258ccfc36cb75
WECHAT_SECRET=

# 签发登录 token 与照片签名 URL。生产环境必填，建议 32 位以上随机字符串。
JWT_SECRET=

# 首个管理员激活码。小程序「分析设置」页输入一次后即关闭。
ADMIN_SETUP_CODE=

# 监听与对外地址
PORT=3100
BASE_PATH=/shelfguard
PUBLIC_BASE_URL=https://game.yft8.cn

# 数据目录（SQLite + 照片）。相对路径相对于 server/ 目录。
DATA_DIR=./data

# 可选：照片 URL 签名密钥。不填则复用 JWT_SECRET。
# FILE_URL_SECRET=

# 可选：登录 token 有效天数，默认 30。小程序每次启动会重新 wx.login。
# TOKEN_TTL_DAYS=30

# 通义千问 DashScope。也可在小程序「分析设置」里填写，环境变量优先。
# DASHSCOPE_API_KEY=

# 腾讯位置服务 WebService Key（逆地理编码）。不填则水印退回坐标。
# TENCENT_MAP_KEY=

# 进销存同步。也可在「分析设置」里填写，环境变量优先。
# JXC_BASE_URL=
# JXC_API_KEY=

# 生产环境不要打开。仅本地冒烟测试用，打开后可用 testOpenid 冒充任意用户。
# SHELFGUARD_TEST_LOGIN=0

# 设为 1 时不启动进程内定时任务（测试用）。
# DISABLE_CRON=0
