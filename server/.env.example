# 复制为 server/.env 后填写。不要把填好的 .env 提交到 git。

# 微信小程序（新主体 AppID）
WECHAT_APPID=wxd60258ccfc36cb75
WECHAT_SECRET=

# 签发登录 token 与照片签名 URL。生产环境必填，建议 32 位以上随机字符串。
JWT_SECRET=

# 首个管理员激活码。小程序「分析设置」页输入一次后即关闭。
ADMIN_SETUP_CODE=

# 监听与对外地址
PORT=3100
BASE_PATH=/shelfguard
PUBLIC_BASE_URL=https://game.yft8.cn

# 数据目录（SQLite + 照片）。相对路径相对于 server/ 目录。
DATA_DIR=./data

# 可选：照片 URL 签名密钥。不填则复用 JWT_SECRET。
# FILE_URL_SECRET=

# 可选：登录 token 有效天数，默认 30。小程序每次启动会重新 wx.login。
# TOKEN_TTL_DAYS=30

# 通义千问 DashScope。也可在小程序「分析设置」里填写，环境变量优先。
# DASHSCOPE_API_KEY=
# 可选：自定义多模态模型名（如 qwen3.8-flash / qwen3.7-plus / qwen3-vl-plus）、有界思考与输出上限
# DASHSCOPE_MODEL=qwen3.8-flash
# DASHSCOPE_ENABLE_THINKING=true
# DASHSCOPE_THINKING_BUDGET=2560
# DASHSCOPE_MAX_TOKENS=6144

# 天地图 Web 服务 API Key（逆地理编码主服务，需在天地图控制台申请并按需配置服务器 IP 白名单）。
# TIANDITU_KEY=
# 腾讯位置服务 WebService Key（可选：作为过渡期兜底；若同时未配置 TIANDITU_KEY 和 TENCENT_MAP_KEY，水印退回坐标）。
# TENCENT_MAP_KEY=
# 可选：显式指定逆地理服务提供方（auto | tianditu | tencent，默认 auto：优先天地图，失败自动兜底腾讯）
# GEOCODE_PROVIDER=auto

# 进销存同步。也可在「分析设置」里填写，环境变量优先。
# JXC_BASE_URL=
# JXC_API_KEY=

# 供进销存 (jxc-app) AI 经营诊断助手调用的内部只读接口密钥（至少 16 位随机字符串）。
# INTERNAL_API_KEY=

# 电脑端网页版拜访地图 (/shelfguard/map) 查看密码（启用网页地图时至少配置其一，未设置则拒绝访问）
# WEB_MAP_PASSWORD= 管理员全量口令（含 admin 记录与照片）
# WEB_MAP_MANAGER_PASSWORD= 管理者只读口令（不含 admin 的任何信息）
# WEB_MAP_PASSWORD=
# WEB_MAP_MANAGER_PASSWORD=

# 生产环境不要打开。仅本地冒烟测试用，打开后可用 testOpenid 冒充任意用户。
# SHELFGUARD_TEST_LOGIN=0

# 设为 1 时不启动进程内定时任务（测试用）。
# DISABLE_CRON=0
